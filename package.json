{
  "name": "mhpayment",
  "version": "1.0.0",
  "private": true,
  "description": "መሠረተ ሕይወት ሰንበት ትምህርት ቤት - የአባልነትና የወርሃዊ ክፍያ አስተዳደር ሥርዓት",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch --env-file-if-exists=.env server/dev.ts",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "seed:dev": "tsx --env-file-if-exists=.env scripts/seed-dev.ts",
    "create-admin": "tsx --env-file-if-exists=.env scripts/create-admin.ts",
    "start": "tsx --env-file-if-exists=.env server/dev.ts",
    "fonts": "node scripts/embed-fonts.mjs"
  },
  "dependencies": {
    "@fontsource/noto-sans-ethiopic": "^5.3.0",
    "@fontsource/noto-serif-ethiopic": "^5.3.0",
    "@js-temporal/polyfill": "^0.5.1",
    "@netlify/blobs": "^11.1.3",
    "abushakir": "^1.5.2",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "jose": "^6.2.12",
    "multer": "^2.4.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "serverless-http": "^4.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.4",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
