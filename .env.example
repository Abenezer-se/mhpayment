# ───────────────────────────────────────────────────────────────
# የአካባቢ ተለዋዋጮች / Environment variables  (copy to .env — never commit .env)
# ───────────────────────────────────────────────────────────────

# REQUIRED. Neon connection string. Use the *pooled* string for the running app
# (host contains "-pooler"). Must end with ?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# OPTIONAL. Direct (non-pooled) Neon string used only by `npm run migrate`.
# If empty, DATABASE_URL is used.
DATABASE_URL_UNPOOLED=

# REQUIRED. Random secret (>= 32 chars) used to sign login sessions.
# Generate:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# OPTIONAL. Session lifetime in hours (default 12)
SESSION_HOURS=12

# OPTIONAL. "netlify" (Netlify Blobs) or "local" (disk). Auto-selected on Netlify.
STORAGE_DRIVER=local
# OPTIONAL. Folder for local storage driver (development only)
LOCAL_UPLOAD_DIR=.data/uploads

# OPTIONAL. Max payment-proof upload size in MB (default 4; Netlify functions accept at most ~6 MB per request)
MAX_UPLOAD_MB=4

# OPTIONAL. Local API port for `npm run dev` (default 8888)
PORT=8888

# OPTIONAL. Set to "development" locally so cookies work on http://localhost
NODE_ENV=development
